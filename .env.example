# Amazon Vendor API V2.1 — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# Never commit the .env file to source control.

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_database_password_here
DB_NAME=amazon_vendor_v2

# ─────────────────────────────────────────────
# Amazon SP-API — LWA (Login With Amazon)
# ─────────────────────────────────────────────
LWA_CLIENT_ID=your_lwa_client_id_here
LWA_CLIENT_SECRET=your_lwa_client_secret_here
REFRESH_TOKEN=your_lwa_refresh_token_here
LWA_ENDPOINT=https://api.amazon.com/auth/o2/token

# ─────────────────────────────────────────────
# Amazon SP-API — AWS SigV4 Signing
# ─────────────────────────────────────────────
SP_API_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
SP_API_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AMAZON_API_BASE_URL=https://sellingpartnerapi-na.amazon.com
USE_SIGV4=true

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────
# CORS — Angular Frontend Origin
# ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
