# New Solution v3 — Environment Configuration
# Copy to .env and fill in real values. Never commit .env to source control.

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_database_password_here
DB_NAME=bi_automation_v3

# ─────────────────────────────────────────────
# Amazon SP-API — LWA (Login With Amazon)
# These 3 are the ONLY required credentials.
# Get from: Seller Central → Apps & Services → Develop Apps
# ─────────────────────────────────────────────
LWA_CLIENT_ID=your_lwa_client_id_here
LWA_CLIENT_SECRET=your_lwa_client_secret_here
REFRESH_TOKEN=your_lwa_refresh_token_here
LWA_ENDPOINT=https://api.amazon.com/auth/o2/token

# ─────────────────────────────────────────────
# Amazon SP-API — AWS SigV4 Signing
# USE_SIGV4=false → AWS IAM keys NOT required (uses LWA-only, same as V1)
# USE_SIGV4=true  → Requires SP_API_AWS_ACCESS_KEY_ID & SECRET below
# ─────────────────────────────────────────────
USE_SIGV4=false

# Only needed if USE_SIGV4=true (leave blank if USE_SIGV4=false):
SP_API_AWS_ACCESS_KEY_ID=
SP_API_AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─────────────────────────────────────────────
# Amazon API
# ─────────────────────────────────────────────
AMAZON_API_BASE_URL=https://sellingpartnerapi-na.amazon.com
MARKETPLACE_ID=ATVPDKIKX0DER

# ─────────────────────────────────────────────
# Redis (required — for token cache + sync status + distributed lock)
# Install: https://redis.io/download  OR  use Docker: docker run -p 6379:6379 redis
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────
# CORS — Angular Frontend
# ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
